# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE FIRMA DIGITAL (NO SENSIBLE) — OFTAPP (DSY1105)
# ==============================================================================
# Copia estas variables en tu archivo local `local.properties` (ignorado por Git)
# o defínelas como variables de entorno antes de ejecutar `.\gradlew.bat assembleRelease`.
# NUNCA subas tu archivo `.jks` real ni contraseñas reales al repositorio público.
#
# Comando para generar tu llave .jks localmente con JDK keytool:
# keytool -genkeypair -v -keystore oftapp-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias oftapp_key
# ==============================================================================

RELEASE_STORE_FILE=C:/ruta/segura/fuera/del/repo/oftapp-release-key.jks
RELEASE_STORE_PASSWORD=CHANGE_ME_STORE_PASSWORD
RELEASE_KEY_ALIAS=oftapp_key
RELEASE_KEY_PASSWORD=CHANGE_ME_KEY_PASSWORD
